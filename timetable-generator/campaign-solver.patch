+/// Solve two coupled defects **together**.
+///
+/// This is the mechanism the campaign's own diagnosis asked for and nothing else in the ladder
+/// provides. Every other subsolver repairs one defect and is judged on the total, so it meets the
+/// arithmetic of §3.2 head on: closing a lecturer window is worth β₇(26²−25²) = 255, the
+/// rearrangement that closes it opens a group window costing β₈(12²−11²) = 460, and the move is
+/// refused. The refusal is correct — that exchange really is a loss — but it is the *pair* that
+/// should have been searched, not the single defect: the arrangement in which the lecturer's вікно
+/// closes and the group's day closes up behind it costs nothing and is invisible to a search that
+/// can only see one of the two.
+///
+/// So the member set spans both buckets, both days, and both entities' pullers, and the exhaustive
+/// search prices the whole rearrangement at once. It is small — at most `jointK` classes — because
+/// the leaf count is the product of the branch factors, and it is bounded by a node budget so that
+/// it stays anytime.
+int Worker::jointSolve(size_t bidA, size_t bidB) {
+  const int dayA = State::bucketDay(bidA);
+  const int dayB = State::bucketDay(bidB);
+  const Mask holesA = st_.holesOf(bidA, 1) | st_.holesOf(bidA, 2);
+  const Mask holesB = st_.holesOf(bidB, 1) | st_.holesOf(bidB, 2);
+  const int holeMinuteA = holesA.empty() ? -1 : p_.ticks[static_cast<size_t>(holesA.lowest())];
+  const int holeMinuteB = holesB.empty() ? -1 : p_.ticks[static_cast<size_t>(holesB.lowest())];
+
+  // Members: the classes nearest each hole, from both buckets, plus one puller apiece.
+  jointMembers_.clear();
+  const auto take = [&](size_t bid, int day, int holeMinute, int want) {
+    st_.bucketMembers(bid, scratch_);
+    std::stable_sort(scratch_.begin(), scratch_.end(), [this, holeMinute](int a, int b) {
+      if (holeMinute < 0) return false;
+      return std::abs(st_.gene(a).start - holeMinute) < std::abs(st_.gene(b).start - holeMinute);
+    });
+    int added = 0;
+    for (int m : scratch_) {
+      if (added >= want) break;
+      if (st_.gene(m).day < 0) continue;
+      if (std::find(jointMembers_.begin(), jointMembers_.end(), m) != jointMembers_.end()) continue;
+      jointMembers_.push_back(m);
+      ++added;
+    }
+    // One class of this entity from another day that can reach the hole: the вікно that closes by
+    // something arriving, rather than by the day closing up.
+    if (holeMinute < 0 || static_cast<int>(jointMembers_.size()) >= o_.jointK) return;
+    st_.entityElsewhere(bid, scratch_);
+    for (int cand : scratch_) {
+      if (std::find(jointMembers_.begin(), jointMembers_.end(), cand) != jointMembers_.end()) continue;
+      const Gene& gc = st_.gene(cand);
+      const int* cs = p_.slotsOf(gc);
+      for (int z = 0; z < gc.slotCount; ++z) {
+        const int sl = cs[z];
+        if (slotDay(sl) != day || slotParity(sl) != gc.parity) continue;
+        if (p_.times[static_cast<size_t>(slotTime(sl))].startMinutes != holeMinute) continue;
+        jointMembers_.push_back(cand);
+        return;
+      }
+    }
+  };
+  take(bidA, dayA, holeMinuteA, (o_.jointK + 1) / 2);
+  take(bidB, dayB, holeMinuteB, o_.jointK - static_cast<int>(jointMembers_.size()));
+  if (jointMembers_.size() < 3) return 0;
+  const int k = static_cast<int>(jointMembers_.size());
+
+  std::vector<Spot> original(static_cast<size_t>(k));
+  for (int m = 0; m < k; ++m) original[static_cast<size_t>(m)] = st_.spotOf(jointMembers_[static_cast<size_t>(m)]);
+  const double before = cost();
+
+  beginCandidate();
+  for (int m = 0; m < k; ++m) {
+    moveTo(jointMembers_[static_cast<size_t>(m)], -1, -1,
+           st_.gene(jointMembers_[static_cast<size_t>(m)]).parity, -1);
+  }
+  settle();
+
+  const int B = std::max(2, o_.repairBranch);
+  std::vector<std::vector<std::pair<int, int>>> cands(static_cast<size_t>(k));
+  for (int m = 0; m < k; ++m) {
+    const int i = jointMembers_[static_cast<size_t>(m)];
+    const Gene& g = st_.gene(i);
+    std::vector<std::pair<double, std::pair<int, int>>> scored;
+    const int* slots = p_.slotsOf(g);
+    const int scanLimit = std::min(g.slotCount, o_.repairScanSlots);
+    const int scanFrom = rng_.belowI(std::max(1, g.slotCount));
+    for (int qq = 0; qq < scanLimit; ++qq) {
+      if ((qq & 31) == 0 && Clock::now() >= repairDeadline_) { undo(); return -1; }
+      const int sl = slots[(scanFrom + qq) % g.slotCount];
+      if (slotParity(sl) != g.parity) continue;
+      const int d = slotDay(sl), ti = slotTime(sl);
+      const Mask mask = p_.maskAt(ti, g.durSlot);
+      if (st_.peopleClashesAt(i, d, mask, g.parity) != 0) continue;
+      const double win = st_.windowCostOfAdding(i, d, g.parity, mask);
+      int room = -1;
+      double roomPenalty = kImpossible;
+      const int* rooms = p_.roomsOf(g);
+      const int limit = std::min(g.roomCount, o_.repairScanRooms);
+      const int start = rng_.belowI(std::max(1, g.roomCount));
+      for (int r = 0; r < limit; ++r) {
+        const int cand = rooms[(start + r) % g.roomCount];
+        if (!st_.placementAllowed(i, d, ti, g.parity, cand)) continue;
+        const double rc = static_cast<double>(st_.roomClashesAt(i, d, mask, g.parity, cand)) * kClashBig;
+        if (rc < roomPenalty) { roomPenalty = rc; room = cand; }
+        if (rc <= 0) break;
+      }
+      if (roomPenalty >= kClashBig) continue;
+      // A placement that lands exactly on one of the two holes is what the joint search is for, so
+      // it is preferred into the candidate list rather than left to compete on the probe alone.
+      const int startMin = p_.times[static_cast<size_t>(ti)].startMinutes;
+      const bool fillsHole = (d == dayA && startMin == holeMinuteA) || (d == dayB && startMin == holeMinuteB);
+      scored.emplace_back(win + roomPenalty - (fillsHole ? 1e6 : 0.0), std::make_pair(sl, room));
+    }
+    if (scored.empty()) { undo(); return 0; }
+    std::sort(scored.begin(), scored.end(),
+              [](const auto& a, const auto& b) { return a.first < b.first; });
+    const Spot& was = original[static_cast<size_t>(m)];
+    const int cur = packSlot(was.day, was.timeIdx, was.parity);
+    auto& list = cands[static_cast<size_t>(m)];
+    list.emplace_back(cur, was.room);
+    for (const auto& sc : scored) {
+      if (static_cast<int>(list.size()) >= B) break;
+      if (sc.second.first == cur && sc.second.second == was.room) continue;
+      list.push_back(sc.second);
+    }
+  }
+
+  std::vector<int> order(static_cast<size_t>(k));
+  for (int m = 0; m < k; ++m) order[static_cast<size_t>(m)] = m;
+  std::stable_sort(order.begin(), order.end(), [&cands](int a, int b) {
+    return cands[static_cast<size_t>(a)].size() < cands[static_cast<size_t>(b)].size();
+  });
+
+  double best = before;
+  std::vector<std::pair<int, int>> bestPick(static_cast<size_t>(k)), pick(static_cast<size_t>(k));
+  bool found = false, truncated = false;
+  int64_t nodes = 0;
+  const std::function<void(int)> dfs = [&](int depth) {
+    if (truncated) return;
+    if (++nodes > o_.repairNodes) { truncated = true; return; }
+    if ((nodes & 255) == 0 && Clock::now() >= repairDeadline_) { truncated = true; return; }
+    if (depth == k) {
+      for (int m = 0; m < k; ++m) {
+        const auto& c = pick[static_cast<size_t>(m)];
+        st_.placeRaw(jointMembers_[static_cast<size_t>(m)], slotDay(c.first), slotTime(c.first),
+                     slotParity(c.first), c.second);
+      }
+      st_.flush();
+      bool legal = true;
+      for (int m = 0; m < k && legal; ++m) {
+        const int i = jointMembers_[static_cast<size_t>(m)];
+        const Gene& g = st_.gene(i);
+        legal = g.day >= 0 && st_.placementAllowed(i, g.day, g.timeIdx, g.parity, g.room);
+      }
+      if (legal) {
+        const double c = cost();
+        if (c < best - 1e-9) { best = c; bestPick = pick; found = true; }
+      }
+      for (int m = 0; m < k; ++m) {
+        st_.placeRaw(jointMembers_[static_cast<size_t>(m)], -1, -1,
+                     st_.gene(jointMembers_[static_cast<size_t>(m)]).parity, -1);
+      }
+      st_.flush();
+      return;
+    }
+    const int m = order[static_cast<size_t>(depth)];
+    for (const auto& c : cands[static_cast<size_t>(m)]) {
+      pick[static_cast<size_t>(m)] = c;
+      dfs(depth + 1);
+      if (truncated) return;
+    }
+  };
+  dfs(0);
+
+  if (!found) { undo(); return truncated ? -1 : 0; }
+  for (int m = 0; m < k; ++m) {
+    const auto& c = bestPick[static_cast<size_t>(m)];
+    moveTo(jointMembers_[static_cast<size_t>(m)], slotDay(c.first), slotTime(c.first),
+           slotParity(c.first), c.second);
+  }
+  settle();
+  if (!allLegal(jointMembers_)) { undo(); return truncated ? -1 : 0; }
+  if (cost() >= before - 1e-9) { undo(); return truncated ? -1 : 0; }
+  jr_.clear();
+  return 1;
+}
+
+int Worker::hardRepair() {
+  if (!haveBest_ || p_.movable.empty()) return kRepairUnproven;
+  ++rep_.hardRepairs;
+  repairDeadline_ = std::min(sh_.deadline, Clock::now() + std::chrono::milliseconds(o_.repairBudgetMs));
+  anchoredRepair_ = true;
+  struct AnchorGuard { bool* f; ~AnchorGuard() { *f = false; } } guard{&anchoredRepair_};
+
+  // Always from the incumbent: a repair anchored to the working state repairs a timetable nobody
+  // is going to keep. This is the same lesson as `kickFromBest` and it is worth restating, because
+  // it is the single change that unfroze the tail in the first place (STUDY.md §6a).
+  st_.restore(bestSpots_);
+  refreshLists();
+
+  // The defects, worst first — the buckets the objective is actually charging for.
+  std::vector<size_t> defects;
+  if (st_.hard() > 0 && o_.useSurge) {
+    // Feasibility surge: the defects are the conflicts, not the windows.
+    st_.conflictBuckets(defects, static_cast<size_t>(o_.repairDefects) * 3);
+  } else {
+    // The hard repair always wants *actionable* defects, whatever the rest of the search is
+    // configured to do: certifying a bucket whose gap is held open by classes this run may not move
+    // is a true statement about a fact nobody can change, and spending the ledger on it makes the
+    // basin look exhausted when it is not.
+    st_.worstWindowBuckets(scratchBuckets_, static_cast<size_t>(o_.repairDefects) * 3, true);
+    defects = scratchBuckets_;
+  }
+  if (defects.empty()) return kRepairUnproven;
+
+  int examined = 0, certified = 0;
+  bool improvedAny = false;
+  bool anyTruncated = false;
+  for (size_t bid : defects) {
+    if (examined >= o_.repairDefects) break;
+    if (Clock::now() >= repairDeadline_) { anyTruncated = true; break; }
+    if (ledgerHas(bid)) continue;   // already proved: do not grind the same "no" for twenty minutes
+    ++examined;
+
+    bool improved = false;
+    bool complete = true;
+    if (o_.repairVerbose) {
+      st_.bucketMembers(bid, scratch_);
+      const Mask h1 = st_.holesOf(bid, 1), h2 = st_.holesOf(bid, 2);
+      std::fprintf(stderr, "[defect bid=%zu day=%d members=%zu holes=%d/%d cost=%.0f soft=%lld]\n",
+                   bid, State::bucketDay(bid), scratch_.size(), h1.popcount(), h2.popcount(),
+                   cost(),
+                   static_cast<long long>((st_.counters().lecWinHalves + st_.counters().grpWinHalves) / 2));
+    }
+    // The ladder, cheapest decisive first. Each runs under strict descent on the true acceptance
+    // cost and leaves no trace when it fails.
+    {
+      const double before = cost();
+      if (o_.useRematch) {
+        ++rep_.repairTried[0];
+        if (tryStrict(opRematch(), before)) { improved = true; ++rep_.repairWon[0]; }
+      }
+    }
+    if (!improved && Clock::now() < repairDeadline_) {
+      ++rep_.repairTried[1];
+      const double dsBefore = cost();
+      const int r = daySolveExact(bid);
+      if (o_.repairVerbose) {
+        std::fprintf(stderr, "   daySolve -> %d  cost %.0f -> %.0f\n", r, dsBefore, cost());
+      }
+      if (r == 1) { improved = true; ++rep_.repairWon[1]; }
+      else if (r < 0) { complete = false; ++rep_.repairCut[1]; }
+    }
+    if (!improved && Clock::now() < repairDeadline_) {
+      const double before = cost();
+      st_.bucketMembers(bid, victims_);
+      if (victims_.size() >= 3) {
+        // The widest permutation the operator can do, aimed straight at this bucket.
+        members_ = victims_;
+        if (static_cast<int>(members_.size()) > o_.koptK) members_.resize(static_cast<size_t>(o_.koptK));
+        ++rep_.repairTried[2];
+        if (tryStrict(permute(members_), before)) { improved = true; ++rep_.repairWon[2]; }
+      }
+    }
+    if (!improved && o_.useJointRepair && Clock::now() < repairDeadline_) {
+      const size_t bidB = coupledDefect(bid);
+      if (bidB != State::kNoBucketId) {
+        ++rep_.repairTried[6];
+        const double jBefore = cost();
+        const int r = jointSolve(bid, bidB);
+        if (r == 1) { improved = true; ++rep_.repairWon[6]; }
+        else if (r < 0) { complete = false; ++rep_.repairCut[6]; }
+        if (o_.repairVerbose) {
+          std::fprintf(stderr, "   joint(%zu,%zu) -> %d  cost %.0f -> %.0f\n", bid, bidB, r, jBefore,
+                       cost());
+        }
+      }
+    }
+    if (!improved && Clock::now() < repairDeadline_) {
+      const double before = cost();
+      ++rep_.repairTried[3];
+      if (tryStrict(opCompaction(bid), before)) { improved = true; ++rep_.repairWon[3]; }
+    }
+    // The compound move: everything above requires its own step to pay, and on a plateau that is an
+    // equilibrium no single step does. This one is allowed to make the timetable worse and then
+    // repair it, and only the pair is judged.
+    if (!improved && o_.useForceClose && Clock::now() < repairDeadline_) {
+      ++rep_.repairTried[5];
+      const double fcBefore = cost();
+      if (forceCloseRepair(bid) == 1) { improved = true; ++rep_.repairWon[5]; }
+      if (o_.repairVerbose) {
+        std::fprintf(stderr, "   forceClose -> %d  cost %.0f -> %.0f\n", improved ? 1 : 0, fcBefore,
+                     cost());
+      }
+    }
+    if (!improved && Clock::now() < repairDeadline_) {
+      ++rep_.repairTried[4];
+      const double ejBefore = cost();
+      const int r = ejectSearch(bid);
+      if (o_.repairVerbose) std::fprintf(stderr, "   eject -> %d  cost %.0f -> %.0f\n", r, ejBefore, cost());
+      if (r == 1) { improved = true; ++rep_.repairWon[4]; }
+      else if (r < 0) { complete = false; ++rep_.repairCut[4]; }
+    }
+
+    if (!improved && Clock::now() >= repairDeadline_) complete = false;
+    if (improved) {
+      improvedAny = true;
+      ++rep_.defectsCleared;
+      if (noteIncumbent()) sinceBest_ = 0;
+      // The complement is no longer what the certificates were relative to.
+      ledger_.clear();
+      break;
+    }
+    if (complete) {
+      ledger_.push_back(bid);
+      ++certified;
+      ++rep_.defectsCertified;
+      // Certified irreducible under the true objective is exactly the condition the flattened one
+      // is for: there is no improving step, so give the walk a stretch in which the exchange that
+      // would close this вікно is not a losing trade, and let f(σ) judge what comes back.
+      if (o_.useFlatPhase && flatUntil_ <= moves_) {
+        flatUntil_ = moves_ + o_.flatMoves;
+        ++rep_.flatPhases;
+      }
+
+      if (static_cast<int>(ledger_.size()) > 64) ledger_.erase(ledger_.begin());
+    } else {
+      anyTruncated = true;
+    }
+  }
+
+  acceptedCost_ = cost();
+  std::fill(history_.begin(), history_.end(), acceptedCost_);
+  dlasMax_ = acceptedCost_;
+  if (improvedAny) { sinceBest_ = 0; return kRepairResumed; }
+
+  // Exhausted only if every defect the enumeration could see has been certified, and nothing was
+  // cut short. "Locally irreducible" is all this claims — irreducible within the neighbourhood cap
+  // and the subsolver family — and that is exactly enough for what it is used for.
+  if (!anyTruncated && examined > 0 && certified == examined) {
+    bool all = true;
+    for (size_t bid : defects) {
+      if (!ledgerHas(bid)) { all = false; break; }
+    }
+    if (all) return kRepairExhausted;
+  }
+  return kRepairUnproven;
+}
+
+/// Take the most distant elite in the pool rather than the best one.
+///
+/// `adoptElite` converges the workers: it takes the shared best whenever that is meaningfully
+/// better, which is the right move while the search is still descending and the wrong one when it
+/// is stuck, because the shared best is usually a near-copy of what this worker already has. When
+/// a basin has been *certified* finished, what is wanted is elsewhere — the pool member furthest
+/// away — even at some cost in quality, since a fresh construction pays far more than that for the
+/// same diversity.
+bool Worker::adoptDistant() {
+  std::vector<Spot> take;
+  {
+    std::lock_guard<std::mutex> lk(sh_.mu);
+    if (sh_.pool.size() < 2) return false;
+    int bestIdx = -1;
+    int64_t bestDist = -1;
+    for (size_t i = 0; i < sh_.pool.size(); ++i) {
+      const auto& e = sh_.pool[i];
+      if (e.unplaced > bestUnplaced_) continue;
+      if (e.objective > bestObjective_ * 1.10 + 1.0) continue;   // not so much worse it undoes the run
+      const int64_t d = Shared::distance(e.spots, bestSpots_);
+      if (d > bestDist) { bestDist = d; bestIdx = static_cast<int>(i); }
+    }
+    const int64_t minDist =
+        std::max<int64_t>(4, static_cast<int64_t>(static_cast<double>(p_.movable.size()) * o_.poolMinDist));
+    if (bestIdx < 0 || bestDist < minDist) return false;
+    take = sh_.pool[static_cast<size_t>(bestIdx)].spots;
+  }
+  st_.restore(take);
+  acceptedCost_ = cost();
+  std::fill(history_.begin(), history_.end(), acceptedCost_);
+  dlasMax_ = acceptedCost_;
+  haveBest_ = false;
+  noteIncumbent();
+  sinceBest_ = 0;
+  ledger_.clear();
+  ++rep_.adoptions;
+  refreshLists();
+  return true;
+}
+
+/// The basin is finished, and this time that is a conclusion rather than a timeout.
+void Worker::onBasinExhausted() {
+  ++rep_.basinSwitches;
+  int policy = o_.switchPolicy;
+  if (policy == 3) {
+    // ε-greedy between "steer the next construction away" and "go and stand somewhere else".
+    if (switchUses_[1] < 2) policy = 1;
+    else if (switchUses_[2] < 2) policy = 2;
+    else if (rng_.chance(0.2)) policy = 1 + rng_.belowI(2);
+    else policy = (switchGain_[1] / std::max(1, switchUses_[1]) <=
+                   switchGain_[2] / std::max(1, switchUses_[2])) ? 1 : 2;
+    if (o_.switchPolicy == 3 && !ledger_.empty() && rng_.chance(0.34)) policy = 4;
+  }
+  lastSwitchPolicy_ = policy;
+  if (policy >= 1) ++switchUses_[policy];
+
+  // Policy 4 is the middle path the certificate makes possible: rebuild only the region that was
+  // proved stuck, and keep the rest of the timetable. Falls back to the biased restart when the
+  // region is too small to be worth it.
+  if (policy == 4) {
+    if (rebuildRegion()) return;
+    policy = 1;
+  }
+  if (policy == 2 && adoptDistant()) return;
+
+  // A biased restart: remember what the certified defects were sitting on, so the construction that
+  // follows does not walk straight back into them. Nothing is forbidden — the penalty is a
+  // preference inside `scanBest`, and a class with nowhere else to go still goes there.
+  if (policy == 1) {
+    antiOn_.assign(st_.genes().size(), 0);
+    antiSpots_.assign(st_.genes().size(), Spot{});
+    for (size_t bid : ledger_) {
+      st_.bucketMembers(bid, scratch_);
+      for (int m : scratch_) {
+        antiOn_[static_cast<size_t>(m)] = 1;
+        antiSpots_[static_cast<size_t>(m)] = bestSpots_.empty() ? st_.spotOf(m)
+                                                               : bestSpots_[static_cast<size_t>(m)];
+      }
+    }
+    antiActive_ = true;
+  }
+  restartFresh();
+  antiActive_ = false;
+}
