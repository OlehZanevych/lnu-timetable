+// improvement leaves it — and widening the bar does not merely lose quality, it prevents the search
+// converging at all (STUDY.md §9.3). So the tail is short of attempts, and the shipped ladder
+// answers that with three stochastic rungs. Every one of them draws: a kick breaks a related set
+// and hopes, a deep phase draws clusters and hopes. When what is left is five lecturers and three
+// groups with one idle пара each, hoping is a poor use of forty minutes: the same few buckets come
+// up again and again, and nothing ever concludes that a particular window cannot be closed at all.
+//
+// This rung concludes. It takes one defect at a time, freezes everything except a bounded
+// neighbourhood of it, and searches that neighbourhood *exhaustively*. Either it removes the defect
+// — which the stochastic operators had failed to do for hundreds of thousands of moves — or it
+// comes back having proved that nothing inside the neighbourhood can, which is a fact worth having:
+// it is what lets the search stop grinding on that defect, and, once every defect has been so
+// certified, what lets it abandon the whole timetable *knowing* rather than on a timer.
+
+bool Worker::ledgerHas(size_t bid) const {
+  return std::find(ledger_.begin(), ledger_.end(), bid) != ledger_.end();
+}
+
+bool Worker::tryStrict(bool applied, double before) {
+  if (!applied) return false;
+  if (cost() < before - 1e-9) { jr_.clear(); return true; }
+  undo();
+  return false;
+}
+
+/// Exact assignment over one (entity, day), with the option of leaving the day.
+///
+/// `dayfix` (§3.4.8) enumerated every arrangement of one day's classes *within* that day and was
+/// measured worse — but it was measured as a member of the bandit's portfolio, where its draws came
+/// out of `repack` and `ruin`, and it could only rearrange, never evict. Both faults are addressed
+/// here: it runs only in the hard repair, where it takes a draw from nothing at all, and each class
+/// carries candidates on *other* days too, so "this window closes only if that class leaves
+/// Tuesday" is inside the search rather than left to a lucky draw elsewhere.
+int Worker::daySolveExact(size_t bid) {
+  const int day = State::bucketDay(bid);
+  st_.bucketMembers(bid, members_);
+  if (members_.size() < 2) {
+    if (o_.repairVerbose) std::fprintf(stderr, "   daySolve: only %zu movable members\n", members_.size());
+    return 0;
+  }
+
+  // Prefer the classes adjacent to the day's holes: those are the ones whose movement can change
+  // the span, and the exact search can only afford a handful.
+  const Mask holes = st_.holesOf(bid, 1) | st_.holesOf(bid, 2);
+  const int holeMinute = holes.empty() ? -1 : p_.ticks[static_cast<size_t>(holes.lowest())];
+  std::stable_sort(members_.begin(), members_.end(), [this, holeMinute](int a, int b) {
+    if (holeMinute < 0) return false;
+    const int da = std::abs(st_.gene(a).start - holeMinute);
+    const int db = std::abs(st_.gene(b).start - holeMinute);
+    return da < db;
+  });
+  int k = std::min<int>(o_.repairDepth, static_cast<int>(members_.size()));
+  members_.resize(static_cast<size_t>(k));
+
+  // A вікно is closed in one of two ways: the day's own classes close up over it, or a class of the
+  // same entity arrives from another day of the week. Everything above can only do the first, which
+  // is why an exact search over one bucket kept coming back with "nothing to be done" — the move
+  // that would have helped was not in its universe. So: up to two *pullers*, classes of this entity
+  // sitting on other days whose own domain contains a slot starting exactly at the hole.
+  if (holeMinute >= 0 && k < o_.repairDepth + 2) {
+    st_.entityElsewhere(bid, scratch_);
+    int added = 0;
+    const int startAt = scratch_.empty() ? 0 : rng_.belowI(static_cast<int>(scratch_.size()));
+    for (int q = 0; q < static_cast<int>(scratch_.size()) && added < 2; ++q) {
+      const int cand = scratch_[static_cast<size_t>((startAt + q) % static_cast<int>(scratch_.size()))];
+      if (std::find(members_.begin(), members_.end(), cand) != members_.end()) continue;
+      const Gene& gc = st_.gene(cand);
+      bool reaches = false;
+      const int* cs = p_.slotsOf(gc);
+      for (int z = 0; z < gc.slotCount && !reaches; ++z) {
+        const int sl = cs[z];
+        if (slotDay(sl) != day || slotParity(sl) != gc.parity) continue;
+        if (p_.times[static_cast<size_t>(slotTime(sl))].startMinutes == holeMinute) reaches = true;
+      }
+      if (!reaches) continue;
+      members_.push_back(cand);
+      ++added;
+    }
+    k = static_cast<int>(members_.size());
+  }
+
+  const int B = std::max(2, o_.repairBranch);
+  std::vector<Spot> original(static_cast<size_t>(k));
+  for (int m = 0; m < k; ++m) original[static_cast<size_t>(m)] = st_.spotOf(members_[static_cast<size_t>(m)]);
+  const double before = cost();
+
+  // Price the candidates with the whole set *lifted out*, exactly as the permutation operator does.
+  // Built against the live state instead, a candidate that wants a slot one of the other members is
+  // currently sitting in reads as a clash and is filtered out before the search ever sees it — which
+  // removes precisely the joint rearrangements this operator exists to find, and is why an earlier
+  // version of it reported no improvement on forty-two consecutive defects.
+  beginCandidate();
+  for (int m = 0; m < k; ++m) moveTo(members_[static_cast<size_t>(m)], -1, -1, st_.gene(members_[static_cast<size_t>(m)]).parity, -1);
+  settle();
+
+  std::vector<std::vector<std::pair<int, int>>> cands(static_cast<size_t>(k));  // (slot, room)
+  for (int m = 0; m < k; ++m) {
+    const int i = members_[static_cast<size_t>(m)];
+    const Gene& g = st_.gene(i);
+    std::vector<std::pair<double, std::pair<int, int>>> scored;
+    const int* slots = p_.slotsOf(g);
+    // The candidate scan is bounded and polls the clock. An exact search whose *setup* can outrun
+    // the budget is not anytime, and the budget independence of §3.9 is a property the whole
+    // measurement design rests on: a run must stop when it is told to.
+    const int scanLimit = std::min(g.slotCount, o_.repairScanSlots);
+    const int scanFrom = rng_.belowI(std::max(1, g.slotCount));
+    for (int qq = 0; qq < scanLimit; ++qq) {
+      if ((qq & 31) == 0 && Clock::now() >= repairDeadline_) { undo(); return -1; }
+      const int q = (scanFrom + qq) % g.slotCount;
+      const int s = slots[q];
+      if (slotParity(s) != g.parity) continue;
+      const int d = slotDay(s), ti = slotTime(s);
+      const Mask mask = p_.maskAt(ti, g.durSlot);
+      const double people = static_cast<double>(st_.peopleClashesAt(i, d, mask, g.parity)) * kClashBig;
+      if (people >= kClashBig) continue;   // a placement that double-books somebody is never wanted
+      const double win = st_.windowCostOfAdding(i, d, g.parity, mask);
+      int room = -1;
+      double roomPenalty = kImpossible;
+      const int* rooms = p_.roomsOf(g);
+      const int limit = std::min(g.roomCount, o_.repairScanRooms);
+      const int start = rng_.belowI(std::max(1, g.roomCount));
+      for (int r = 0; r < limit; ++r) {
+        const int cand = rooms[(start + r) % g.roomCount];
+        if (!st_.placementAllowed(i, d, ti, g.parity, cand)) continue;
+        const double rc = static_cast<double>(st_.roomClashesAt(i, d, mask, g.parity, cand)) * kClashBig;
+        if (rc < roomPenalty) { roomPenalty = rc; room = cand; }
+        if (rc <= 0) break;
+      }
+      if (room == -1 && g.roomCount > 0 && p_.roomsOf(g)[0] >= 0) continue;
+      if (roomPenalty >= kClashBig) continue;
+      // Off-day candidates are charged a small preference against, so that the search prefers to
+      // solve the day if it can and evicts only when eviction genuinely pays.
+      const double away = (d == day) ? 0.0 : 1.0;
+      scored.emplace_back(people + roomPenalty + win + away, std::make_pair(s, room));
+    }
+    if (scored.empty()) { undo(); return 0; }
+    std::sort(scored.begin(), scored.end(),
+              [](const auto& a, const auto& b) { return a.first < b.first; });
+    // The class's current placement is always a candidate, or the search could not return the
+    // identity and "no improvement" would be unprovable.
+    const Spot& was = original[static_cast<size_t>(m)];
+    const int cur = packSlot(was.day, was.timeIdx, was.parity);
+    auto& list = cands[static_cast<size_t>(m)];
+    list.emplace_back(cur, was.room);
+    for (const auto& sc : scored) {
+      if (static_cast<int>(list.size()) >= B) break;
+      if (sc.second.first == cur && sc.second.second == was.room) continue;
+      list.push_back(sc.second);
+    }
+  }
+
+  // Fewest candidates first: the standard variable order, and it makes the prune bite earliest.
+  std::vector<int> order(static_cast<size_t>(k));
+  for (int m = 0; m < k; ++m) order[static_cast<size_t>(m)] = m;
+  std::stable_sort(order.begin(), order.end(), [&cands](int a, int b) {
+    return cands[static_cast<size_t>(a)].size() < cands[static_cast<size_t>(b)].size();
+  });
+
+  double best = before;
+  std::vector<std::pair<int, int>> bestPick(static_cast<size_t>(k));
+  std::vector<std::pair<int, int>> pick(static_cast<size_t>(k));
+  bool found = false;
+  int64_t nodes = 0;
+  bool truncated = false;
+  const auto deadline = repairDeadline_;
+
+  const std::function<void(int)> dfs = [&](int depth) {
+    if (truncated) return;
+    if (++nodes > o_.repairNodes) { truncated = true; return; }
+    if ((nodes & 255) == 0 && Clock::now() >= deadline) { truncated = true; return; }
+    if (depth == k) {
+      for (int m = 0; m < k; ++m) {
+        const auto& c = pick[static_cast<size_t>(m)];
+        st_.placeRaw(members_[static_cast<size_t>(m)], slotDay(c.first), slotTime(c.first),
+                     slotParity(c.first), c.second);
+      }
+      st_.flush();
+      bool legal = true;
+      for (int m = 0; m < k && legal; ++m) {
+        const int i = members_[static_cast<size_t>(m)];
+        const Gene& g = st_.gene(i);
+        legal = g.day >= 0 && st_.placementAllowed(i, g.day, g.timeIdx, g.parity, g.room);
+      }
+      if (legal) {
+        const double c = cost();
+        if (c < best - 1e-9) { best = c; bestPick = pick; found = true; }
+      }
+      for (int m = 0; m < k; ++m) {
+        st_.placeRaw(members_[static_cast<size_t>(m)], -1, -1, st_.gene(members_[static_cast<size_t>(m)]).parity, -1);
+      }
+      st_.flush();
+      return;
+    }
+    const int m = order[static_cast<size_t>(depth)];
+    for (const auto& c : cands[static_cast<size_t>(m)]) {
+      pick[static_cast<size_t>(m)] = c;
+      dfs(depth + 1);
+      if (truncated) return;
+    }
+  };
+  dfs(0);
+  if (o_.repairVerbose) {
+    size_t total = 1;
+    for (int m = 0; m < k; ++m) total *= std::max<size_t>(1, cands[static_cast<size_t>(m)].size());
+    std::fprintf(stderr, "   daySolve: k=%d leaves<=%zu nodes=%lld found=%d best=%.0f before=%.0f\n",
+                 k, total, static_cast<long long>(nodes), found ? 1 : 0, best, before);
+  }
+
+  if (!found) { undo(); return truncated ? -1 : 0; }
+
+  for (int m = 0; m < k; ++m) {
+    const auto& c = bestPick[static_cast<size_t>(m)];
+    moveTo(members_[static_cast<size_t>(m)], slotDay(c.first), slotTime(c.first), slotParity(c.first),
+           c.second);
+  }
+  settle();
+  if (!allLegal(members_)) { undo(); return truncated ? -1 : 0; }
+  if (cost() >= before - 1e-9) { undo(); return truncated ? -1 : 0; }
+  jr_.clear();
+  return 1;
+}
+
+/// A bounded ejection search over one defect.
+///
+/// `opChain` (§3.4.3) already displaces: it moves a class, then sends whoever is now double-booked
+/// where *that* class would choose, to depth three. What it never does is *reconsider* — one
+/// placement per link, no backtracking — so a chain that would have paid two links further on is
+/// indistinguishable from one that never had a chance. Here every link tries several placements and
+/// the search backtracks, which is the difference between a heuristic chain and a Lin–Kernighan
+/// one, and it is affordable because it runs a few hundred times in a run rather than a few hundred
+/// thousand times a second.
+int Worker::ejectSearch(size_t bid) {
+  st_.bucketMembers(bid, members_);
+  if (members_.empty()) return 0;
+  const double before = cost();
+  int64_t nodes = 0;
+  bool truncated = false;
+  std::vector<int> inChain;
+
+  const std::function<bool(int, int)> descend = [&](int cls, int depth) -> bool {
+    if (truncated) return false;
+    if (depth > o_.repairEjectDepth) return false;
+    if (++nodes > o_.repairNodes / 4) { truncated = true; return false; }
+    if ((nodes & 63) == 0 && Clock::now() >= repairDeadline_) { truncated = true; return false; }
+    const Gene& g = st_.gene(cls);
+    if (g.slotCount == 0) return false;
+    // A few placements for this link, best-first by the same probe the construction uses.
+    std::vector<std::pair<double, std::pair<int, int>>> options;
+    const int* slots = p_.slotsOf(g);
+    const int startSlot = rng_.belowI(g.slotCount);
+    const int ejectLimit = std::min(g.slotCount, o_.repairScanSlots);
+    for (int q = 0; q < ejectLimit && static_cast<int>(options.size()) < o_.repairBranch * 3; ++q) {
+      if ((q & 31) == 0 && Clock::now() >= repairDeadline_) { truncated = true; return false; }
+      const int s = slots[(startSlot + q) % g.slotCount];
+      if (slotParity(s) != g.parity) continue;
+      const int d = slotDay(s), ti = slotTime(s);
+      if (d == g.day && ti == g.timeIdx) continue;
+      const Mask mask = p_.maskAt(ti, g.durSlot);
+      const int people = st_.peopleClashesAt(cls, d, mask, g.parity);
+      if (people > 1) continue;   // one class in the way is an ejection; two is a mess
+      const double win = st_.windowCostOfAdding(cls, d, g.parity, mask);
+      int room = -1;
+      const int* rooms = p_.roomsOf(g);
+      const int limit = std::min(g.roomCount, o_.repairScanRooms);
+      const int rs = rng_.belowI(std::max(1, g.roomCount));
+      for (int r = 0; r < limit; ++r) {
+        const int cand = rooms[(rs + r) % g.roomCount];
+        if (!st_.placementAllowed(cls, d, ti, g.parity, cand)) continue;
+        if (st_.roomClashesAt(cls, d, mask, g.parity, cand) != 0) continue;
+        room = cand;
+        break;
+      }
+      if (room < 0 && g.roomCount > 0 && p_.roomsOf(g)[0] >= 0) continue;
+      options.emplace_back(win + people * 1000.0, std::make_pair(s, room));
+    }
+    std::sort(options.begin(), options.end(),
+              [](const auto& a, const auto& b) { return a.first < b.first; });
+    const int tries = std::min<int>(o_.repairBranch, static_cast<int>(options.size()));
+    for (int t = 0; t < tries; ++t) {
+      const int s = options[static_cast<size_t>(t)].second.first;
+      const int room = options[static_cast<size_t>(t)].second.second;
+      const int d = slotDay(s), ti = slotTime(s);
+      const Mask mask = p_.maskAt(ti, st_.gene(cls).durSlot);
+      const size_t mark = jr_.size();
+      // Whoever is in the way is the next link.
+      const int victim = st_.occupantOf(cls, d, mask, st_.gene(cls).parity, room);
+      int peopleVictim = -1;
+      if (victim < 0) {
+        // A people clash rather than a room clash: find the class it is with.
+        const Gene& gc = st_.gene(cls);
+        for (int kk = 0; kk < gc.lecCount && peopleVictim < 0; ++kk) {
+          for (int32_t z : st_.lecBucket(p_.lecPool[static_cast<size_t>(gc.lecFrom + kk)], d)) {
+            const Gene& gz = st_.gene(z);
+            if (z != cls && gz.movable && weeksOverlap(gc.parity, gz.parity) && mask.intersects(gz.mask)) {
+              peopleVictim = z;
+              break;
+            }
+          }
+        }
+        for (int kk = 0; kk < gc.grpCount && peopleVictim < 0; ++kk) {
+          for (int32_t z : st_.grpBucket(p_.grpPool[static_cast<size_t>(gc.grpFrom + kk)], d)) {
+            const Gene& gz = st_.gene(z);
+            if (z != cls && gz.movable && weeksOverlap(gc.parity, gz.parity) && mask.intersects(gz.mask)) {
+              peopleVictim = z;
+              break;
+            }
+          }
+        }
+      }
+      moveTo(cls, d, ti, st_.gene(cls).parity, room);
+      settle();
+      if (std::find(inChain.begin(), inChain.end(), cls) == inChain.end()) inChain.push_back(cls);
+      const int next = victim >= 0 ? victim : peopleVictim;
+      bool ok = false;
+      // The set-valued rule again (§1.3): every class the chain has moved has to be legal against
+      // the state the *whole* chain leaves behind, and the chain is `inChain` — the defect's own
+      // bucket members are not the set that moved.
+      if (cost() < before - 1e-9 && allLegal(inChain) && st_.gene(cls).day >= 0) {
+        ok = true;
+      } else if (next >= 0 && std::find(inChain.begin(), inChain.end(), next) == inChain.end()) {
+        inChain.push_back(next);
+        ok = descend(next, depth + 1);
+        if (!ok) inChain.pop_back();
+      }
+      if (ok) return true;
+      // Backtrack this link.
+      while (jr_.size() > mark) {
+        st_.placeRaw(jr_.back().first, jr_.back().second);
+        jr_.pop_back();
+      }
+      st_.flush();
+      if (truncated) return false;
+    }
+    return false;
+  };
+
+  beginCandidate();
+  bool improved = false;
+  const int roots = std::min<int>(3, static_cast<int>(members_.size()));
+  for (int r = 0; r < roots && !improved && !truncated; ++r) {
+    inChain.clear();
+    inChain.push_back(members_[static_cast<size_t>(r)]);
+    improved = descend(members_[static_cast<size_t>(r)], 1);
+  }
+  if (improved && cost() < before - 1e-9) { jr_.clear(); return 1; }
+  undo();
+  return truncated ? -1 : 0;
+}
+
+/// Force the defect out, then pay for the damage.
+///
+/// The diagnostic that produced this operator is worth stating, because it is the sharpest thing
+/// the campaign found. Once the hard repair was aimed at *actionable* defects, its exact day-slice
+/// search explored up to forty-six thousand complete arrangements of six classes — including
+/// pulling a class in from another day — and returned `best == before` **exactly**, defect after
+/// defect. The incumbent is not stuck for want of search: it is a genuine strict local optimum.
+///
+/// The reason is the quadratic objective. Closing one lecturer window when there are twenty-six of
+/// them is worth β₇(26² − 25²) = 255; the rearrangement that closes it almost always opens a group
+/// window, and the first group window among twelve costs β₈(12² − 11²) = 460. Every single-defect
+/// repair is a trade that loses. The residual is an equilibrium, and no procedure that requires
+/// each step to improve can leave one.
+///
+/// So this one does not require it. It closes the вікно *unconditionally* — the compaction sweep,
+/// applied whatever it costs — and then spends a bounded descent repairing whatever that broke,
+/// with the search's own portfolio aimed by `focus_` at the classes the forced move disturbed.
+/// Only the pair is judged: if the timetable that comes out the other side is better than the one
+/// that went in, it is kept, and if not, nothing happened. It is the compound move — worse, then
+/// better — that a plateau-locked search cannot construct out of single steps.
+int Worker::forceCloseRepair(size_t bid) {
+  const double before = cost();
+  // An explicit snapshot, not the journal. Every operator opens its own candidate with
+  // `beginCandidate`, which *clears* the journal — so a compound move that spans several operator
+  // calls cannot be rolled back through it, and an earlier version of this routine silently left
+  // the forced move applied whenever the repair failed. A snapshot is a few hundred kilobytes and
+  // this runs a handful of times a second at most.
+  st_.snapshotInto(forceSnapshot_);
+  if (!opCompaction(bid)) { st_.restore(forceSnapshot_); return 0; }
+  jr_.clear();
+
+  // 2. Aim the descent at what the force disturbed: the classes it moved, and everything that
+  //    shares a lecturer or a group with them.
+  focus_.clear();
+  for (int i : p_.movable) {
+    const Spot& was = forceSnapshot_[static_cast<size_t>(i)];
+    const Gene& g = st_.gene(i);
+    if (g.day != was.day || g.timeIdx != was.timeIdx || g.room != was.room || g.parity != was.parity) {
+      focus_.push_back(i);
+    }
+  }
+  if (focus_.empty()) { st_.restore(forceSnapshot_); return 0; }
+  const size_t direct = focus_.size();
+  for (size_t q = 0; q < direct && focus_.size() < 512; ++q) {
+    const int m = focus_[q];
+    const Gene& g = st_.gene(m);
+    for (int kk = 0; kk < g.lecCount && focus_.size() < 512; ++kk) {
+      for (int d : p_.days) {
+        for (int32_t z : st_.lecBucket(p_.lecPool[static_cast<size_t>(g.lecFrom + kk)], d)) {
+          if (st_.gene(z).movable && focus_.size() < 512) focus_.push_back(z);
+        }
+      }
+    }
+    for (int kk = 0; kk < g.grpCount && focus_.size() < 512; ++kk) {
+      for (int d : p_.days) {
+        for (int32_t z : st_.grpBucket(p_.grpPool[static_cast<size_t>(g.grpFrom + kk)], d)) {
+          if (st_.gene(z).movable && focus_.size() < 512) focus_.push_back(z);
+        }
+      }
+    }
+  }
+  std::sort(focus_.begin(), focus_.end());
+  focus_.erase(std::unique(focus_.begin(), focus_.end()), focus_.end());
+
+  // 3. A bounded descent over the damage. Equal-cost moves are admitted deliberately: plateau drift
+  //    is most of what there is to do on a surface whose objective is a sum of squares of small
+  //    integers, and a descent that refuses it cannot cross from one arrangement to the next.
+  const double savedFocus = focusShare_;
+  focusShare_ = 0.85;
+  double cur = cost();
+  for (int m = 0; m < o_.repairDescent; ++m) {
+    if ((m & 127) == 0 && Clock::now() >= repairDeadline_) break;
+    const int op = pickOperator();
+    if (!applyOperator(op)) continue;
+    const double after = cost();
+    if (after <= cur + 1e-9) {
+      cur = after;
+      jr_.clear();
+    } else {
+      undo();
+    }
+  }
+  focusShare_ = savedFocus;
+  focus_.clear();
+
+  if (cost() < before - 1e-9) { jr_.clear(); return 1; }
+  st_.restore(forceSnapshot_);
+  jr_.clear();
+  return 0;
+}
+
+/// The defect coupled to this one: the bucket that the move repairing this one would disturb.
+///
+/// Two (entity, day) buckets are coupled when a class sits in both — a lecturer's Tuesday and the
+/// group's Tuesday that the same lecture serves. That is exactly the relation the endgame turns on:
+/// the rearrangement that closes the lecturer's вікно moves a class that the group also has, and the
+/// group's day pays for it. Coupling is therefore the right thing to search *jointly* over.
+size_t Worker::coupledDefect(size_t bidA) const {
+  st_.bucketMembers(bidA, const_cast<std::vector<int>&>(members_));
+  size_t best = State::kNoBucketId;
+  int bestScore = 0;
+  std::vector<size_t> bs;
+  std::vector<std::pair<size_t, int>> shared;   // candidate bucket -> classes in common with A
+  for (int m : members_) {
+    const Gene& g = st_.gene(m);
+    if (g.day < 0) continue;
+    st_.entityBuckets(m, g.day, bs);
+    for (size_t bid : bs) {
+      if (bid == bidA) continue;
+      bool seen = false;
+      for (auto& e : shared) {
+        if (e.first == bid) { ++e.second; seen = true; break; }
+      }
+      if (!seen) shared.emplace_back(bid, 1);
+    }
+  }
+  for (const auto& e : shared) {
+    if (st_.movableCountIn(e.first) < 2) continue;   // nothing there this run may move
+    // Coupling strength first, existing windows only as a tie-break. The partner worth searching
+    // jointly is the bucket that would *acquire* the вікно, not one that already has one: the whole
+    // reason the single-defect search refuses to close A is that the class it must move is one B
+    // also holds, and B's day is currently tidy. Requiring B to be damaged already excluded exactly
+    // the partner the mechanism exists for.
+    const int w = st_.windowsIn(e.first);
+    const int score = e.second * 10 + (st_.isGroupBucket(e.first) ? w * 4 : w);
+    if (score > bestScore) { bestScore = score; best = e.first; }
+  }
+  return best;
+}
