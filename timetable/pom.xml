<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.6</version>
		<relativePath/>
	</parent>
	<groupId>org.lnu</groupId>
	<artifactId>timetable</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>timetable</name>
	<description>GraphQL timetable service with auto-generated schema and optimized R2DBC queries</description>

	<properties>
		<java.version>25</java.version>
		<r2dbc-postgresql.version>1.1.1.RELEASE</r2dbc-postgresql.version>
		<lombok.version>1.18.46</lombok.version>
		<guava.version>33.6.0-jre</guava.version>
		<jjwt.version>0.12.6</jjwt.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-graphql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-r2dbc</artifactId>
		</dependency>

		<!-- Database -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>r2dbc-postgresql</artifactId>
			<version>${r2dbc-postgresql.version}</version>
		</dependency>

		<!-- Schema migrations. Flyway speaks JDBC and this service speaks R2DBC, so the JDBC driver
		     comes along with it: the only JDBC connection this application ever opens is the one
		     Flyway uses at startup. flyway-database-postgresql is Flyway's PostgreSQL support, a
		     separate artifact since Flyway 10; both versions are managed by the Boot parent.

		     spring-boot-flyway is what actually makes any of it run, and it is easy to leave out.
		     Spring Boot 4 split spring-boot-autoconfigure into one module per technology — what is
		     left of it is twelve core auto-configurations, and Flyway's is not among them. Without
		     this dependency flyway-core sits on the classpath unused: no Flyway bean is created,
		     nothing binds spring.flyway.*, and the application starts perfectly normally having
		     migrated nothing at all. There is no warning, because from Boot's point of view nobody
		     asked for Flyway. It brings spring-boot-jdbc with it, which is where DataSourceBuilder
		     lives; no connection pool comes along, so DataSourceAutoConfiguration finds neither a
		     pool nor an embedded driver nor a spring.datasource.url and creates nothing, leaving
		     Flyway's own SimpleDriverDataSource (built from spring.flyway.url) the only JDBC
		     DataSource in the context, which is the intent. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Common -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<version>${lombok.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>${guava.version}</version>
		</dependency>

		<!-- Authentication / authorization (see org.lnu.timetable.security): password hashing +
		     JWT only, deliberately not the full spring-boot-starter-security, since authorization
		     here is entity-scoped (see PermissionService) rather than URL/method-role-based and is
		     wired directly into the GraphQL layer via a WebGraphQlInterceptor. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-crypto</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
